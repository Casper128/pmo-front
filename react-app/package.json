{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:domain-sync": "node scripts/check-domain-sync.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:architecture && npm run check:domain-sync && npm run build",
