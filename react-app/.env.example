# Variables de entorno de react-app (Vite solo expone las que empiezan por VITE_).
# En Netlify se configuran en Site settings > Environment variables.
# En local: copie este archivo a .env.local (ignorado por git) y complete los valores
# con los de src/environments/environment.ts de la app Angular.

# URL base de la API PMO (API Gateway).
VITE_API_BASE_URL=
# URL del proyecto Supabase.
VITE_SUPABASE_URL=
# Clave publicable de Supabase (no es secreta, pero no se versiona aquí).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Correos separados por comas.
VITE_CONFIGURATION_ADMIN_EMAILS=
VITE_LOCATION_ADMIN_EMAILS=
