{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias por capa (docs/migration-plan.md §4.1) */
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./src/domain/*"],
      "@application/*": ["./src/application/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@presentation/*": ["./src/presentation/*"],
      "@env/*": ["./src/config/*"]
    },

    /* Rigor (misma línea que el tsconfig de Angular) */
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
    /*
     * Sin verbatimModuleSyntax, erasableSyntaxOnly ni noUnusedLocals/Parameters: src/domain se copia
     * sin cambios desde Angular (imports de tipos sin `type`, parameter properties, código no usado).
     * Los no usados los controla ESLint (@typescript-eslint/no-unused-vars).
     */
  },
  "include": ["src"]
}
